{
  "name": "cozycrowns-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "benchmark:book-clubs": "tsx benchmarks/book-clubs.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:validate": "tsx src/db/migrate.ts --validate-only",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@workos-inc/node": "^9.3.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "nanoid": "^5.1.16",
    "posthog-node": "^5.54.1",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "node-gyp": "^12.3.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "esbuild@0": "0.28.1",
      "@grpc/grpc-js@1": "1.14.5",
      "tar@7": "7.5.21",
      "undici@6": "6.28.1",
      "ws@8": "8.21.0",
      "protobufjs@7": "7.6.5",
      "@opentelemetry/propagator-jaeger@2": "2.9.0",
      "fast-uri@3": "3.1.8",
      "find-my-way@9": "9.7.0",
      "nanoid@5": "5.1.16",
      "@opentelemetry/core@2": "2.8.0",
      "fastify@5": "5.12.5",
      "fast-copy@4": "4.1.0",
      "tinypool@2": "2.1.2"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
